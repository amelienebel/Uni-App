        {
          "name": "Potenzregel",
          "latex": "\\frac{d}{dx}\\,x^n = n\\,x^{n-1}",
          "chapter_id": "k4",
          "explanation": "Ableitung einer Potenzfunktion."
        },
        {
          "name": "Produktregel",
          "latex": "(u\\cdot v)' = u'\\,v + u\\,v'",
          "chapter_id": "k4",
          "explanation": "Ableitung eines Produkts zweier Funktionen."
        },
        {
          "name": "Kettenregel",
          "latex": "\\big(f(g(x))\\big)' = f'(g(x))\\cdot g'(x)",
          "chapter_id": "k4",
          "explanation": "Äußere mal innere Ableitung."
        },
        {
          "name": "Geometrische Reihe",
          "latex": "\\sum_{k=0}^{n-1} q^k = \\frac{1-q^n}{1-q}, \\quad q \\neq 1",
          "chapter_id": "k2",
          "explanation": "Grundlage für Renten- und Annuitätenformeln."
        },
        {
          "name": "Lagrange-Funktion",
          "latex": "L(x,y,\\lambda) = f(x,y) + \\lambda\\,\\big(c - g(x,y)\\big)",
          "chapter_id": "k7",
          "explanation": "Optimierung von f unter der Nebenbedingung g(x,y)=c."
        },
        {
          "name": "Inverse einer 2x2-Matrix",
          "latex": "A^{-1} = \\frac{1}{ad-bc}\\begin{pmatrix} d & -b \\\\ -c & a \\end{pmatrix}",
          "chapter_id": "k10",
          "explanation": "Existiert nur für det(A) = ad - bc ≠ 0."
        }
      ],
