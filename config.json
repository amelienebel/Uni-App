      "base_formulas": [
        {
          "name": "Bilanzgleichung",
          "latex": "\\text{Aktiva} = \\text{Passiva} = \\text{Eigenkapital} + \\text{Fremdkapital}",
          "chapter_id": "k2",
          "explanation": "Mittelverwendung = Mittelherkunft."
        },
        {
          "name": "Lineare Abschreibung",
          "latex": "AfA = \\frac{AK - RW}{ND}",
          "chapter_id": "k5",
          "explanation": "AK = Anschaffungskosten, RW = Restwert, ND = Nutzungsdauer."
        },
        {
          "name": "Geometrisch-degressive Abschreibung",
          "latex": "AfA_t = RBW_{t-1} \\cdot p",
          "chapter_id": "k5",
          "explanation": "Fester Prozentsatz p vom Restbuchwert des Vorjahres."
        },
        {
          "name": "Erfolgsermittlung (GuV)",
          "latex": "\\text{Jahresüberschuss} = \\text{Erträge} - \\text{Aufwendungen}",
          "chapter_id": "k9",
          "explanation": "Saldo der Gewinn- und Verlustrechnung."
        },
        {
          "name": "Eigenkapitalquote",
          "latex": "EK\\text{-Quote} = \\frac{EK}{GK} \\cdot 100\\,\\%",
          "chapter_id": "k10",
          "explanation": "Anteil des Eigenkapitals am Gesamtkapital."
        },
        {
          "name": "Umsatzsteuer-Zahllast",
          "latex": "\\text{Zahllast} = \\text{Umsatzsteuer} - \\text{Vorsteuer}",
          "chapter_id": "k4",
          "explanation": "Wird an das Finanzamt abgeführt."
        }
