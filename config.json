      "base_formulas": [
        {"name": "Kapitalwert (NPV)", "latex": "C_0 = -I_0 + \\sum_{t=1}^{T} \\frac{CF_t}{(1+i)^t}", "chapter_id": "k4", "explanation": "Investition vorteilhaft, wenn C_0 > 0."},
        {"name": "Barwert / Abzinsung", "latex": "K_0 = \\frac{K_t}{(1+i)^t}", "chapter_id": "k2", "explanation": "Wert einer zukünftigen Zahlung heute."},
        {"name": "Rentenbarwertfaktor", "latex": "RBF(i,T) = \\frac{(1+i)^T - 1}{i\\,(1+i)^T}", "chapter_id": "k2", "explanation": "Barwert einer nachschüssigen Rente von 1 € über T Perioden."},
        {"name": "Annuität", "latex": "A = C_0 \\cdot \\frac{i\\,(1+i)^T}{(1+i)^T - 1}", "chapter_id": "k5", "explanation": "Kapitalwert × Annuitätenfaktor (Kehrwert des RBF)."},
        {"name": "Interner Zinsfuß", "latex": "0 = -I_0 + \\sum_{t=1}^{T} \\frac{CF_t}{(1+r)^t}", "chapter_id": "k5", "explanation": "r ist der Zins, bei dem der Kapitalwert null wird."},
        {"name": "Leverage-Formel", "latex": "r_{EK} = r_{GK} + (r_{GK} - r_{FK}) \\cdot \\frac{FK}{EK}", "chapter_id": "k9", "explanation": "Eigenkapitalrendite steigt mit Verschuldung, solange r_GK > r_FK."},
        {"name": "CAPM", "latex": "E(r_i) = r_f + \\beta_i \\,\\big(E(r_M) - r_f\\big)", "chapter_id": "k10", "explanation": "Erwartete Rendite = risikoloser Zins + Beta × Marktrisikoprämie."}
      ]
