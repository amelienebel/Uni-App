      "base_formulas": [
        {
          "name": "Barwert / Abzinsung",
          "latex": "K_0 = \\frac{K_t}{(1+i)^t}",
          "chapter_id": "k1",
          "explanation": "Wert einer zukünftigen Zahlung heute."
        },
        {
          "name": "Rentenbarwertfaktor",
          "latex": "RBF(i,T) = \\frac{(1+i)^T - 1}{i\\,(1+i)^T}",
          "chapter_id": "k1",
          "explanation": "Barwert einer nachschüssigen Rente von 1 € über T Perioden."
        },
        {
          "name": "Kapitalwert (NPV)",
          "latex": "C_0 = -I_0 + \\sum_{t=1}^{T} \\frac{CF_t}{(1+i)^t}",
          "chapter_id": "k2",
          "explanation": "Investition vorteilhaft, wenn C_0 > 0."
        },
        {
          "name": "Interner Zinsfuß",
          "latex": "0 = -I_0 + \\sum_{t=1}^{T} \\frac{CF_t}{(1+r)^t}",
          "chapter_id": "k2",
          "explanation": "r ist der Zins, bei dem der Kapitalwert null wird."
        },
        {
          "name": "Annuität",
          "latex": "A = C_0 \\cdot \\frac{i\\,(1+i)^T}{(1+i)^T - 1}",
          "chapter_id": "k2",
          "explanation": "Kapitalwert × Annuitätenfaktor (Kehrwert des RBF)."
        },
        {
          "name": "Kurs einer Kuponanleihe",
          "latex": "P = \\sum_{t=1}^{T} \\frac{C}{(1+y)^t} + \\frac{N}{(1+y)^T}",
          "chapter_id": "k3",
          "explanation": "C = Kupon, N = Nennwert, y = Rendite (Yield to Maturity)."
        },
        {
          "name": "Dividendenbarwertmodell (Gordon-Wachstum)",
          "latex": "P_0 = \\frac{Div_1}{r_E - g}",
          "chapter_id": "k3",
          "explanation": "Konstantes Dividendenwachstum g < r_E."
        },
        {
          "name": "Erwartete Portfoliorendite",
          "latex": "E(R_P) = \\sum_i x_i \\, E(R_i)",
          "chapter_id": "k5",
          "explanation": "x_i = Portfoliogewicht von Wertpapier i."
        },
        {
          "name": "CAPM",
          "latex": "E(r_i) = r_f + \\beta_i \\,\\big(E(r_M) - r_f\\big)",
          "chapter_id": "k5",
          "explanation": "Erwartete Rendite = risikoloser Zins + Beta × Marktrisikoprämie."
        },
        {
          "name": "WACC",
          "latex": "r_{WACC} = \\frac{E}{E+D}\\,r_E + \\frac{D}{E+D}\\,r_D\\,(1-\\tau_c)",
          "chapter_id": "k7",
          "explanation": "Gewichtete Kapitalkosten nach Steuern."
        }
      ],
