        {"name": "Arithmetisches Mittel", "latex": "\\bar{x} = \\frac{1}{n}\\sum_{i=1}^{n} x_i", "chapter_id": "k3", "explanation": "Lagemaß für metrische Merkmale."},
        {"name": "Empirische Varianz", "latex": "s^2 = \\frac{1}{n}\\sum_{i=1}^{n} (x_i - \\bar{x})^2 = \\overline{x^2} - \\bar{x}^2", "chapter_id": "k4", "explanation": "Verschiebungssatz rechts; Achtung: Vorlesung kann auch 1/(n-1) verwenden."},
        {"name": "Variationskoeffizient", "latex": "v = \\frac{s}{\\bar{x}}", "chapter_id": "k4", "explanation": "Relatives Streuungsmaß (nur für x̄ > 0)."},
        {"name": "Korrelationskoeffizient nach Bravais-Pearson", "latex": "r_{xy} = \\frac{\\sum (x_i-\\bar{x})(y_i-\\bar{y})}{\\sqrt{\\sum (x_i-\\bar{x})^2 \\sum (y_i-\\bar{y})^2}}", "chapter_id": "k6", "explanation": "Maß für den linearen Zusammenhang, -1 ≤ r ≤ 1."},
        {"name": "KQ-Regressionsgerade", "latex": "\\hat{y} = a + b\\,x, \\quad b = \\frac{s_{xy}}{s_x^2}, \\quad a = \\bar{y} - b\\,\\bar{x}", "chapter_id": "k7", "explanation": "Methode der kleinsten Quadrate."},
        {"name": "Preisindex nach Laspeyres", "latex": "P^L_{0t} = \\frac{\\sum p_t\\, q_0}{\\sum p_0\\, q_0}", "chapter_id": "k8", "explanation": "Gewichtung mit Mengen der Basisperiode."},
        {"name": "Gini-Koeffizient (normiert)", "latex": "G^* = \\frac{n}{n-1}\\, G", "chapter_id": "k5", "explanation": "Normierung auf das Intervall [0, 1]."}
