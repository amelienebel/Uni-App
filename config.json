      "base_formulas": [
        {
          "name": "Arithmetisches Mittel",
          "latex": "\\bar{x} = \\frac{1}{n}\\sum_{i=1}^{n} x_i",
          "chapter_id": "k2",
          "explanation": "Lagemaß für metrische Merkmale."
        },
        {
          "name": "Empirische Varianz",
          "latex": "s^2 = \\frac{1}{n}\\sum_{i=1}^{n} (x_i - \\bar{x})^2 = \\overline{x^2} - \\bar{x}^2",
          "chapter_id": "k2",
          "explanation": "Verschiebungssatz rechts; Achtung: in der Vorlesung prüfen, ob 1/n oder 1/(n-1) verwendet wird."
        },
        {
          "name": "Variationskoeffizient",
          "latex": "v = \\frac{s}{\\bar{x}}",
          "chapter_id": "k2",
          "explanation": "Relatives Streuungsmaß (nur für x̄ > 0)."
        },
        {
          "name": "Gini-Koeffizient (normiert)",
          "latex": "G^* = \\frac{n}{n-1}\\, G",
          "chapter_id": "k2",
          "explanation": "Konzentrationsmaß, Normierung auf das Intervall [0, 1]."
        },
        {
          "name": "Korrelationskoeffizient nach Bravais-Pearson",
          "latex": "r_{xy} = \\frac{\\sum (x_i-\\bar{x})(y_i-\\bar{y})}{\\sqrt{\\sum (x_i-\\bar{x})^2 \\sum (y_i-\\bar{y})^2}}",
          "chapter_id": "k3",
          "explanation": "Maß für den linearen Zusammenhang, -1 ≤ r ≤ 1."
        },
        {
          "name": "Erwartungswert einer diskreten Zufallsvariable",
          "latex": "E(X) = \\sum_{i} x_i \\, P(X = x_i)",
          "chapter_id": "k4",
          "explanation": "Gewichteter Mittelwert der möglichen Ausprägungen."
        },
        {
          "name": "Konfidenzintervall für μ (σ bekannt)",
          "latex": "\\bar{x} \\pm z_{1-\\alpha/2} \\cdot \\frac{\\sigma}{\\sqrt{n}}",
          "chapter_id": "k6",
          "explanation": "Überdeckt μ mit Wahrscheinlichkeit 1−α."
        },
        {
          "name": "Gauß-Teststatistik",
          "latex": "T = \\frac{\\bar{X} - \\mu_0}{\\sigma / \\sqrt{n}}",
          "chapter_id": "k7",
          "explanation": "Einstichprobentest für μ bei bekanntem σ."
        },
        {
          "name": "KQ-Regressionsgerade",
          "latex": "\\hat{y} = a + b\\,x, \\quad b = \\frac{s_{xy}}{s_x^2}, \\quad a = \\bar{y} - b\\,\\bar{x}",
          "chapter_id": "k8",
          "explanation": "Methode der kleinsten Quadrate."
        }
      ],
